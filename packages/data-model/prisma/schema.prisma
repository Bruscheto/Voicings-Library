generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A voicing is a shape: intervals above its lowest note. It stands for the
// same voicing in all twelve keys; bassMidi only records where it was authored.
// Chords are not stored — they are readings of the shape (see VoicingReading).
model Voicing {
  id        String   @id @default(uuid())
  name      String?
  intervals Int[]    // CHECK: starts at 0, strictly ascending
  bassMidi  Int      // CHECK: 21..108
  shapeKey  String   @unique // intervals joined by "-"
  structure String[] @default([]) // engine-derived: shell, rootless-a, drop2…
  status    String   @default("ready") // CHECK: draft | ready
  source    String?

  readings VoicingReading[]
  tags     VoicingTag[]

  createdAt DateTime @default(now())
}

// One way to read a shape, relative to its bass so it holds in every key:
// rootOffset 9 on a shape whose bass is C means an A-rooted chord.
model VoicingReading {
  id         String   @id @default(uuid())
  voicingId  String
  rootOffset Int      // CHECK: 0..11
  quality    String   // CHECK: base quality (harmony BASE_QUALITIES)
  tensions   String[] @default([])
  rootless   Boolean  @default(false)
  isPrimary  Boolean  @default(false) // partial unique index: one per voicing

  voicing Voicing @relation(fields: [voicingId], references: [id], onDelete: Cascade)

  @@unique([voicingId, rootOffset, quality])
  @@index([quality])
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  voicings VoicingTag[]
}

model VoicingTag {
  voicingId String
  tagId     String
  voicing   Voicing @relation(fields: [voicingId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId],     references: [id], onDelete: Restrict)

  @@id([voicingId, tagId])
  @@index([tagId])
}
