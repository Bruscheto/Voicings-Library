{
  "name": "voicings-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "d": "turbo run dev",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter e2e run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:import": "ts-node --project tsconfig.scripts.json scripts/import-voicings-from-csv.ts docs/data/voicings-seed.csv",
    "seed:dry-run": "ts-node --project tsconfig.scripts.json scripts/import-voicings-from-csv.ts docs/data/voicings-seed.csv --dry-run",
    "voicings:reanalyze": "ts-node --project tsconfig.scripts.json scripts/reanalyze-voicings.ts"
  },
  "devDependencies": {
    "chalk": "^4.1.2",
    "csv-parse": "^7.0.3",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.5",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  }
}
