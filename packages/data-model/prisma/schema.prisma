generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Chord {
  id       String         @id @default(uuid())
  symbol   String         @unique
  root     String         // CHECK constraint enforces valid pitch class
  quality  String         // CHECK constraint enforces valid quality
  tensions String[]       @default([])

  voicings VoicingChord[]

  @@index([quality])
}

model Voicing {
  id        String         @id @default(uuid())
  name      String?
  pitches   String[]       @default([])
  slashBass String?

  chords VoicingChord[]
  tags   VoicingTag[]

  createdAt DateTime @default(now())
}

model VoicingChord {
  id        String @id @default(uuid())
  voicingId String
  chordId   String

  voicing Voicing @relation(fields: [voicingId], references: [id])
  chord   Chord   @relation(fields: [chordId], references: [id])

  @@unique([voicingId, chordId])
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  voicings VoicingTag[]
}

model VoicingTag {
  voicingId String
  tagId     String
  voicing   Voicing @relation(fields: [voicingId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId],     references: [id], onDelete: Restrict)

  @@id([voicingId, tagId])
  @@index([tagId])
}
